+void ProjectM::SetAudioLevelsOverride(const float* levels)
+{
+    m_audioLevelsOverride = levels != nullptr;
+    if (levels != nullptr)
+    {
+        for (int i = 0; i < 6; i++)
+        {
+            m_audioLevels[i] = levels[i];
+        }
+    }

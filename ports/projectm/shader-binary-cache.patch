+        ProgramBinary binary;
+        bool found = false;
+        {
+            std::lock_guard<std::mutex> lock(g_programCacheMutex);
+            auto it = g_programCache.find(cacheKey);
+            if (it != g_programCache.end())
+            {
+                binary = it->second;
+                found = true;
+            }
+        }
+        if (found)
+        {
+            glProgramBinary(m_shaderProgram, binary.format, binary.data.data(), static_cast<GLsizei>(binary.data.size()));
+            GLint linked{GL_FALSE};
+            glGetProgramiv(m_shaderProgram, GL_LINK_STATUS, &linked);
+            std::lock_guard<std::mutex> lock(g_programCacheMutex);
+            if (linked == GL_TRUE)
+            {
+                g_programCacheHits++;
+                return;
+            }
+            g_programCache.erase(cacheKey); // e.g. driver update: compile normally
+        }
+        glProgramParameteri(m_shaderProgram, GL_PROGRAM_BINARY_RETRIEVABLE_HINT, GL_TRUE);
+    }

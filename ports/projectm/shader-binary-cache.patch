+// feishin-visualizer: process-wide cache of linked program binaries, keyed by the full shader
+// sources. A second projectM instance on a background thread (own GL context) loads upcoming
+// presets, so their programs are already compiled when the visible instance switches; repeated
+// presets also hit the cache. Needs glGetProgramBinary/glProgramBinary (GL 4.1 or
+// ARB_get_program_binary); without it everything compiles as before.
+namespace {
+struct ProgramBinary
+{
+    GLenum format{};
+    std::vector<char> data;
+};
+std::mutex g_programCacheMutex;
+std::unordered_map<std::string, ProgramBinary> g_programCache;
+unsigned int g_programCacheHits{};
+unsigned int g_programCacheMisses{};
+
+bool ProgramBinariesSupported()
+{
+#if defined(_WIN32)
+    return glProgramBinary != nullptr && glGetProgramBinary != nullptr && glProgramParameteri != nullptr;
+#elif defined(GL_PROGRAM_BINARY_LENGTH)
+    return true;
+#else
+    return false;
+#endif
+}
+} // namespace
